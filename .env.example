# Variables para la conexión a la base de datos además del usuario y contraseña del usuario que va a usar dicha base de datos
DB_HOST=localhost (o db_host)
DB_NAME=db_name
DB_PORT=db_port
DB_USER=user_name
DB_PASSWORD=user_password

# Nombre y contraseña del usuario administrador de la base de datos (por defecto postgres en ambos campos)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres